# Copy this file to .env and fill in YOUR OWN values.
# Never commit .env or share real keys.

# === Supabase (public values) ===
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# === Secrets (server only, keep private) ===
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=your-resend-api-key
LOVABLE_CRON_SECRET=generate-a-long-random-secret

# === Database migrations (only needed when running Drizzle migrations) ===
# Postgres connection string from Supabase Dashboard -> Settings -> Database -> Connection string
LOVABLE_DB_MIGRATION_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
